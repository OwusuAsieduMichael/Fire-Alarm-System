# Next.js local API
JWT_SECRET=fireguard-vercel-dev-secret-change-me

# Supabase — Dashboard → Project Settings → API
# URL must be https://xxxx.supabase.co  (NOT the postgres connection string)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Required for ESP32 ingest + control command queue (Secret key / service_role)
# Also used for presentation login unlock (auto-confirm email so demos reach the dashboard)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Presentation: SUPABASE_SERVICE_ROLE_KEY enables /api/auth/register + confirm-email
# so signup/login skip confirmation emails and resend limits.

# Leave these unset — production uses same-origin /api + ESP32 HTTP (no NestJS):
# NEXT_PUBLIC_API_URL=
# NEXT_PUBLIC_WS_URL=
