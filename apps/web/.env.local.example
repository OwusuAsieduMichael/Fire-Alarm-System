# Next.js local API (used until Supabase Auth is wired)
JWT_SECRET=fireguard-vercel-dev-secret-change-me

# Supabase — Dashboard → Project Settings → API
# URL must be https://xxxx.supabase.co  (NOT the postgres connection string)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Prefer the anon / publishable key from the API settings page
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only — service_role (never commit, never use NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional NestJS (leave unset on Vercel for same-origin /api):
# NEXT_PUBLIC_API_URL=http://localhost:4000
# NEXT_PUBLIC_WS_URL=http://localhost:4000
