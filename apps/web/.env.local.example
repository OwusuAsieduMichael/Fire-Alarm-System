# --- Recommended production (Vercel + Google Apps Script) ---
# Set this in Vercel Environment Variables (server-only, not NEXT_PUBLIC_):
# GAS_SCRIPT_URL=https://script.google.com/macros/s/XXXX/exec

# Optional local JWT secret when not using GAS (in-memory Next API fallback)
JWT_SECRET=fireguard-vercel-dev-secret-change-me

# Leave unset on Vercel. Only set if you want NestJS instead of /api:
# NEXT_PUBLIC_API_URL=http://localhost:4000
# NEXT_PUBLIC_WS_URL=http://localhost:4000
